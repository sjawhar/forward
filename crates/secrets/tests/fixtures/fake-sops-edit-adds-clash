#!/bin/bash
# `sops <file>` edit stand-in: saves the file with one more assignment, the way
# a human adding a key does. Two knobs stand in for another writer landing
# while the editor is open: FAKE_SOPS_CLOBBER_TARGET rewrites that agent file;
# FAKE_SOPS_CREATE_HUMAN creates that human-tier file. Every other invocation
# is refused so a test that reaches for decryption through this fixture fails
# loudly.
if (($# != 1)) || [[ "$1" == -* ]]; then
  printf '%s\n' 'fake-sops-edit-adds-clash: expected exactly one file argument (edit mode)' >&2
  exit 64
fi
if [ -n "${FAKE_SOPS_LOG:-}" ]; then
  printf '%s\n' "$1" >> "$FAKE_SOPS_LOG"
fi
printf 'CLASH=added-by-edit\n' >> "$1"
if [ -n "${FAKE_SOPS_CLOBBER_TARGET:-}" ]; then
  printf 'OTHER_WRITER=won\n' > "$FAKE_SOPS_CLOBBER_TARGET"
fi
if [ -n "${FAKE_SOPS_CREATE_HUMAN:-}" ]; then
  printf 'ciphertext\n' > "$FAKE_SOPS_CREATE_HUMAN"
fi

#!/bin/bash
set -eu

marker="${FAKE_SOPS_FAIL_ONCE_MARKER:?}"
count=0
if [ -e "$marker" ]; then
  count=$(cat "$marker")
fi
count=$((count + 1))
printf '%s\n' "$count" > "$marker"

path="${!#}"
if [[ "$path" == /proc/self/fd/* ]]; then
  path=$(readlink "$path")
fi

if [ -n "${FAKE_SOPS_LOG:-}" ]; then
  printf '%s\n' "$path" >> "$FAKE_SOPS_LOG"
fi

if [ -n "${FAKE_SOPS_WAIT_MARKER:-}" ]; then
  while [ ! -e "$FAKE_SOPS_WAIT_MARKER" ]; do
    sleep 0.01
  done
fi


if [ "$count" -eq 1 ]; then
  printf '%s\n' "${FAKE_SOPS_FAIL_STDERR:-age: yubikey plugin: Failed to decrypt YubiKey stanza. Did you touch it?}" >&2
  [ -z "${FAKE_SOPS_FAIL_DONE_MARKER:-}" ] || : > "$FAKE_SOPS_FAIL_DONE_MARKER"
  exit 1
fi

if grep -qFx 'always-stanza' "$path"; then
  printf '%s\n' 'age: yubikey plugin: Failed to decrypt YubiKey stanza. Did you touch it?' >&2
  [ -z "${FAKE_SOPS_FAIL_DONE_MARKER:-}" ] || : > "$FAKE_SOPS_FAIL_DONE_MARKER"
  exit 1
fi

FAKE_SOPS_LOG= exec "$(dirname "$0")/fake-sops-ok" "$@"
